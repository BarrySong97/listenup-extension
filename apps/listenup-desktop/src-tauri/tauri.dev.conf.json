{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ListenUp Desktop DEV",
  "identifier": "com.listenup.desktop.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ListenUp Desktop DEV",
        "width": 400,
        "height": 640,
        "minWidth": 340,
        "minHeight": 420,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "externalBin": ["target/sidecars/listenup"],
    "createUpdaterArtifacts": false
  }
}
