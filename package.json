{
  "name": "listenup-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "build:extension": "pnpm --filter @listenup/extension build",
    "build:extension:native-demo": "pnpm --filter @listenup/extension build:native-demo",
    "build:chrome": "pnpm --filter @listenup/extension build:chrome",
    "build:firefox": "pnpm --filter @listenup/extension build:firefox",
    "build:website": "pnpm --filter @listenup/website build",
    "build:web:static": "BUILD_STATIC=1 pnpm --filter @listenup/website build",
    "build:desktop": "pnpm --filter @listenup/desktop tauri:build",
    "build:desktop:dev": "pnpm --filter @listenup/desktop tauri:build:dev",
    "dev": "turbo run dev --parallel",
    "dev:extension": "pnpm --filter @listenup/extension dev",
    "dev:chrome": "pnpm --filter @listenup/extension dev:chrome",
    "dev:firefox": "pnpm --filter @listenup/extension dev:firefox",
    "dev:website": "pnpm --filter @listenup/website dev",
    "web": "pnpm --filter @listenup/website dev",
    "dev:desktop": "pnpm --filter @listenup/desktop tauri:dev",
    "install:desktop-host": "pnpm --filter @listenup/desktop host:install",
    "uninstall:desktop-host": "pnpm --filter @listenup/desktop host:uninstall",
    "check:environments": "node scripts/check-environment-identifiers.mjs",
    "lint": "turbo run lint",
    "start:website": "pnpm --filter @listenup/website start"
  },
  "devDependencies": {
    "turbo": "^2.9.15"
  }
}
