{
  "name": "@listenup/desktop",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:dev": "LISTENUP_ENV=development VITE_LISTENUP_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "node scripts/gen-info-plist.mjs && tauri build --bundles app --config src-tauri/tauri.cli.conf.json",
    "tauri:build:dev": "LISTENUP_ENV=development VITE_LISTENUP_ENV=development node scripts/gen-info-plist.mjs && LISTENUP_ENV=development VITE_LISTENUP_ENV=development tauri build --bundles app --config src-tauri/tauri.dev.conf.json",
    "cli:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin listenup",
    "host:install": "node scripts/install-host.mjs",
    "host:uninstall": "node scripts/uninstall-host.mjs"
  },
  "dependencies": {
    "@listenup/youtube-core": "workspace:*",
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "@iconify/react": "^6.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "i18next": "^26.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "virtua": "^0.41.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
