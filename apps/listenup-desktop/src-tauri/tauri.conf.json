{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ListenUp Desktop",
  "mainBinaryName": "listenup-desktop",
  "version": "0.5.0",
  "identifier": "com.listenup.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "node scripts/prepare-cli.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ListenUp Desktop",
        "width": 400,
        "height": 640,
        "minWidth": 340,
        "minHeight": 420,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOUYwOEVDN0U0MjdFNUMKUldSY2ZrSis3QWlmL3hxSVBGcmZKdXh4ek16Q1VtOVljdkM3Rno5OXFndGFLVVYxdEVpY3ZpUUQK",
      "endpoints": [
        "https://github.com/BarrySong97/listenup-extension/releases/latest/download/latest.json"
      ]
    }
  }
}
