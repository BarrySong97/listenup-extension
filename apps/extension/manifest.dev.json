{
  "name": "ListenUp DEV",
  "description": "ListenUp development build — interactive YouTube subtitles.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "action": {
    "default_icon": {
      "16": "dev-icon-16.png",
      "32": "dev-icon-32.png",
      "48": "dev-icon-48.png",
      "128": "dev-icon-128.png"
    },
    "default_popup": "src/pages/popup/index.html"
  },
  "icons": {
    "16": "dev-icon-16.png",
    "32": "dev-icon-32.png",
    "48": "dev-icon-48.png",
    "128": "dev-icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "dev-icon-16.png",
        "dev-icon-32.png",
        "dev-icon-48.png",
        "dev-icon-128.png",
        "scripts/*.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "key": ""
}
